{{ ansible_managed | comment }}

abi <abi/3.0>,

#include <tunables/global>

/usr/sbin/nginx {% if nginx_aa_complain | default(true) %}flags=(complain) {% endif %}{
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # Master starts as root, binds its ports, then drops to the worker user and signals workers.
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability kill,
  capability net_bind_service,
  capability setgid,
  capability setuid,
  # capability sys_resource,   # needed if worker_rlimit_nofile is set above the default limit

  # Sockets: TCP only
  network inet stream,
  network inet6 stream,

  # Binary, self re-exec on binary upgrade (USR2), dynamic modules
  /usr/sbin/nginx mrix,
  /usr/lib/nginx/modules/*.so mr,

  # Configuration
  /etc/nginx/ r,
  /etc/nginx/** r,

  # Unsure, seems related to systemd hardening
  /etc/machine-id r,

  # Logs
  /var/log/nginx/ r,
  /var/log/nginx/** rw,

  # Runtime
  /run/nginx.pid rw,
  /run/nginx.lock rw,

  # http{} temp/cache dirs (client bodies, proxy buffering)
  /var/cache/nginx/ r,
  /var/cache/nginx/** rwk,

  # Signalling between master and workers, and from systemd (reload/stop)
  signal (send, receive) peer=/usr/sbin/nginx,
  signal (receive) peer=unconfined,

  # Host-specific paths
{% for item in nginx_harden_paths %}
{% set perm = 'r' if item.ro | default(true) else 'rw' %}
{% set kind = item.type | default('dir') %}
{% if kind == 'dir' %}
  {{ item.path }}/ {{ perm }},
  {{ item.path }}/** {{ perm }},
{% elif kind == 'file' %}
  {{ item.path }} {{ perm }},
{% elif kind == 'socket' %}
  {{ item.path }} rw,
{% endif %}
{% endfor %}
}
