{{ ansible_managed | comment }}
server {
    listen {{ wireguard_ip }}:443 ssl;
    http2 on;
    server_name cloudgw.{{ all_net.mt.domain }} {{ wireguard_ip }};

    ssl_certificate {{ crowdsec_api_server_tls.cert_file }};
    ssl_certificate_key {{ crowdsec_api_server_tls.key_file }};

    access_log {{ nginx_sites_logs }}/access-direct.log {{ nginx_access_log_options }};
    error_log {{ nginx_sites_logs }}/error-direct.log {{ nginx_error_log_options }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /crowdsec-metrics {
        if ($crowdsec_metrics_authorized = 0) {
            return 401;
        }
        proxy_pass http://{{ crowdsec_prometheus_listen_addr }}:{{ crowdsec_prometheus_listen_port }}/metrics;
    }

    location / {
        return 444;
    }
}
