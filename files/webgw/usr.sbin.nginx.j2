{{ ansible_managed | comment }}

# Starts in complain mode: remove "flags=(complain)" below to enforce.

abi <abi/3.0>,

#include <tunables/global>

/usr/sbin/nginx flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # Master starts as root, binds 22/443, then drops to the nginx user.
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability net_bind_service,
  capability setgid,
  capability setuid,
  # capability sys_resource,   # needed if worker_rlimit_nofile is set above the default limit

  # Sockets: TCP only
  network inet stream,
  network inet6 stream,

  # Binary, self re-exec on binary upgrade (USR2), dynamic modules
  /usr/sbin/nginx mrix,
  /usr/lib/nginx/modules/*.so mr,

  # Configuration
  /etc/nginx/ r,
  /etc/nginx/** r,

  # TLS material (read-only)
  /etc/lego/certificates/ r,
  /etc/lego/certificates/** r,
  /etc/ssl/localcerts/ r,
  /etc/ssl/localcerts/** r,

  # Logs
  /var/log/nginx/ r,
  /var/log/nginx/** rw,

  # Runtime
  /run/nginx.pid rw,
  /run/nginx.lock rw,

  # http{} temp/cache dirs (client bodies, proxy buffering)
  /var/cache/nginx/ r,
  /var/cache/nginx/** rwk,

  # Signalling between master and workers, and from systemd (reload/stop)
  signal (send, receive) peer=/usr/sbin/nginx,
  signal (receive) peer=unconfined,
}
